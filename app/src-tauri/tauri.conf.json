{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Compute Substrate Node",
  "version": "0.1.0",
  "identifier": "network.computesubstrate.node",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Compute Substrate Node",
        "width": 460,
        "height": 680,
        "minWidth": 380,
        "minHeight": 480,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:8789 https://cairn-substrate.com ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "dmg",
      "app",
      "nsis"
    ],
    "externalBin": [
      "binaries/csd"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "A Compute Substrate node on your own computer",
    "longDescription": "Runs a Compute Substrate node: it keeps a full copy of the network, checks every block itself, and lets apps on this computer use it.",
    "category": "Utility",
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "resources": {
      "commonplace/": "commonplace/"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "web+csd"
        ]
      }
    }
  }
}
